<%
page.title = page.title || '小游戏'
page.subtitle = page.subtitle || '几款能随时开一局的经典小游戏'
page.banner_img = page.banner_img || theme.page.banner_img
page.banner_img_height = page.banner_img_height || theme.page.banner_img_height
page.banner_mask_alpha = page.banner_mask_alpha || theme.page.banner_mask_alpha

/* 机台样式只在这一页需要（别的页面上的入口是站内链接，不是即开即玩的机台），
   所以用主题的页面级注入 helper，而不是挂到全站的 custom_css 上 */
import_css('/', 'css/games.css')

var gData = site.data.games || {}
var gameList = (gData.games || []).filter(function (g) {
  return g && g.id && g.enabled !== false
})
var gamesOn = gData.enabled !== false && gameList.length > 0
var featured = gData.featured

/* 卡片顶部的图标：按 id 取，认不出来就用通用的摇杆。
   加新游戏时如果没在这里登记，卡片会退化成默认图标 —— 不影响能不能玩。 */
var GLYPHS = {
  snake: '<path d="M2.6 12.8h2.2a1.6 1.6 0 0 0 1.6-1.6V6.6a1.6 1.6 0 0 1 1.6-1.6h2.6"/>' +
    '<circle cx="11.9" cy="5" r="1.7"/>' +
    '<path d="M12.7 6.4v1.2"/>' +
    '<circle cx="4.4" cy="12.6" r="0.9" fill="currentColor"/>',
  g2048: '<rect x="2" y="2" width="5" height="5" rx="1"/>' +
    '<rect x="9" y="2" width="5" height="5" rx="1"/>' +
    '<rect x="2" y="9" width="5" height="5" rx="1"/>' +
    '<rect x="9" y="9" width="5" height="5" rx="1" fill="currentColor"/>',
  tetris: '<rect x="2" y="2" width="4" height="4" rx="0.8"/>' +
    '<rect x="6" y="2" width="4" height="4" rx="0.8"/>' +
    '<rect x="10" y="2" width="4" height="4" rx="0.8"/>' +
    '<rect x="10" y="6" width="4" height="4" rx="0.8" fill="currentColor"/>' +
    '<rect x="6" y="6" width="4" height="4" rx="0.8"/>',
  breakout: '<rect x="2" y="2.5" width="4" height="2.4" rx="0.7"/>' +
    '<rect x="7" y="2.5" width="4" height="2.4" rx="0.7"/>' +
    '<rect x="12" y="2.5" width="2" height="2.4" rx="0.7"/>' +
    '<rect x="2" y="6" width="3" height="2.4" rx="0.7"/>' +
    '<rect x="6" y="6" width="4" height="2.4" rx="0.7"/>' +
    '<circle cx="10.5" cy="9.6" r="1.5" fill="currentColor"/>' +
    '<rect x="6" y="13" width="5" height="1.9" rx="0.9"/>',
  minesweeper: '<circle cx="8" cy="9" r="4.4"/>' +
    '<path d="M8 4.6V1.8M8 1.8h3M8 1.8H5"/>' +
    '<circle cx="8" cy="9" r="1.2" fill="currentColor"/>' +
    '<path d="M11.4 6l1.8-1.8"/>',
  default: '<circle cx="8" cy="3.6" r="2"/>' +
    '<path d="M8 5.6v5"/>' +
    '<path d="M3.4 13.4h9.2M4.7 13.4l1.5-2.9M11.3 13.4l-1.5-2.9"/>'
}

function glyphOf(id) {
  var body = GLYPHS[id] || GLYPHS.default
  return '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" ' +
    'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + body + '</svg>'
}
%>

<div class="gm-app" id="gm-app">
  <header class="gm-hero">
    <h1 class="gm-hero-title">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="8" cy="3.4" r="2"/><path d="M8 5.4v5.1"/>
        <path d="M3.4 13.4h9.2"/><path d="M4.7 13.4l1.5-2.9"/><path d="M11.3 13.4l-1.5-2.9"/>
      </svg>
      <span><%= page.title %></span>
    </h1>
    <p class="gm-hero-lead"><%= page.subtitle %></p>
    <% if (gamesOn) { %>
      <div class="gm-hero-meta">
        <span>共 <%= gameList.length %> 款</span>
        <span>点卡片直接在页面上开玩，不用跳转</span>
        <span>最高分会记在这台设备上</span>
      </div>
    <% } %>
  </header>

  <div class="gm-notice" id="gm-notice" hidden></div>

  <% if (!gamesOn) { %>
    <p class="gm-hero-lead">小游戏暂时关闭了。开回来要在后台「游戏」页把总开关打开。</p>
  <% } else { %>
    <ul class="gm-grid" id="gm-grid">
      <% for (var i = 0; i < gameList.length; i++) { %>
        <%
          var g = gameList[i]
          var isFeatured = g.id === featured
          var tags = g.tags || []
          var accent = g.accent || ''
        %>
        <li>
          <button type="button" class="gm-card" data-game="<%= g.id %>"
                  <% if (accent) { %>style="--gm-accent: <%= accent %>"<% } %>
                  aria-label="开始玩<%= g.name || g.id %>">
            <span class="gm-card-top">
              <% if (isFeatured) { %><span class="gm-card-badge">推荐</span><% } %>
              <span class="gm-card-glyph"><%- glyphOf(g.id) %></span>
            </span>
            <span class="gm-card-body">
              <span class="gm-card-name"><%= g.name || g.id %></span>
              <span class="gm-card-desc"><%= g.desc || '' %></span>
              <span class="gm-card-foot">
                <% for (var t = 0; t < tags.length; t++) { %>
                  <span class="gm-tag"><%= tags[t] %></span>
                <% } %>
                <% if (g.controls) { %><span class="gm-keys"><%= g.controls %></span><% } %>
                <span class="gm-best" data-best="<%= g.id %>">还没玩过</span>
              </span>
            </span>
          </button>
        </li>
      <% } %>
    </ul>
    <noscript>
      <p class="gm-hero-lead">小游戏需要开启 JavaScript 才能运行。</p>
    </noscript>
  <% } %>
</div>
