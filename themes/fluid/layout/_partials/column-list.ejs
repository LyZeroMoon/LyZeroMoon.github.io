<%
/* 专栏（分类）页的文章列表：按标题序号顺序排列，读者可切换正序/倒序。
   rows 由 scripts/column-order.js 的 colSortedPosts 助手算好（已排好序）。 */
%>

<style>
  .col-list {
    margin: 0;
  }
  .col-list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .col-list-count {
    font-size: 14px;
    color: var(--sec-text-color);
  }
  .col-list-count strong {
    color: var(--text-color);
    font-weight: 600;
  }
  .col-list-sort {
    display: inline-flex;
    padding: 2px;
    border: 1px solid var(--line-color);
    border-radius: 999px;
  }
  .col-sort-btn {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    background: transparent;
    color: var(--sec-text-color);
    font-size: 12.5px;
    line-height: 1.5;
    padding: 4px 13px;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color .15s ease, color .15s ease;
  }
  .col-sort-btn:hover {
    color: var(--text-color);
  }
  .col-sort-btn[aria-pressed="true"] {
    background: color-mix(in srgb, var(--text-color) 9%, transparent);
    color: var(--text-color);
    font-weight: 600;
  }
  .col-sort-btn:focus-visible {
    outline: 2px solid var(--post-link-color);
    outline-offset: 1px;
  }
  .col-list-items {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-color);
  }
  .col-list-items li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 11px 10px;
    border-bottom: 1px solid var(--line-color);
    transition: background-color .15s ease;
  }
  .col-list-items li:hover {
    background: color-mix(in srgb, var(--text-color) 4%, transparent);
  }
  .col-ord {
    flex: 0 0 auto;
    min-width: 2.2em;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--post-link-color);
    font-variant-numeric: tabular-nums;
  }
  .col-link {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 14.5px;
    color: var(--text-color);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .col-link:hover {
    color: var(--post-link-color);
    text-decoration: none;
  }
  .col-date {
    flex: 0 0 auto;
    font-size: 12px;
    color: var(--sec-text-color);
    font-variant-numeric: tabular-nums;
  }
  .col-list-empty {
    padding: 40px 0;
    text-align: center;
    color: var(--sec-text-color);
    font-size: 14px;
  }

  @media (max-width: 576px) {
    .col-list-items li { padding: 10px 4px; }
    .col-link { white-space: normal; }
    .col-date { display: none; }
  }
</style>

<div class="col-list" data-column-list>
  <div class="col-list-head">
    <div class="col-list-count">共 <strong><%= rows.length %></strong> 篇 · 按顺序排列</div>
    <div class="col-list-sort" role="group" aria-label="排序方式">
      <button type="button" class="col-sort-btn" data-order="asc" aria-pressed="true">正序</button>
      <button type="button" class="col-sort-btn" data-order="desc" aria-pressed="false">倒序</button>
    </div>
  </div>

  <% if (!rows.length) { %>
    <p class="col-list-empty">这个专栏下还没有文章。</p>
  <% } else { %>
    <ol class="col-list-items">
      <% rows.forEach(function (row, i) { %>
        <li data-i="<%= i %>">
          <span class="col-ord"><%= row.ord === null ? '·' : colOrdLabel(row.ord) %></span>
          <a class="col-link" href="<%= url_for(row.post.path) %>"><%= row.post.title %></a>
          <time class="col-date" datetime="<%= date_xml(row.post.date) %>"><%= date(row.post.date, 'MM-DD') %></time>
        </li>
      <% }) %>
    </ol>
  <% } %>
</div>
