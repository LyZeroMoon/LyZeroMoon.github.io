<%
  // head.ejs 里的变量不会流到这里（partial 之间不共享局部变量），所以自己算一遍
  var navUi = site.data.ui || {}
  var navUiSkins = (navUi.skins || []).filter(function (s) { return s && s.id && s.enabled !== false })
  // 只有一套皮肤时切换器没有意义，不渲染入口
  var navUiSwitchable = navUi.allowSwitch !== false && navUiSkins.length > 1
  // 「街机」皮肤额外挂一个「直接开一局」的快捷入口（样式和脚本都写死了这个 id）。
  // 入口本身一直渲染，靠 CSS 的 :root[data-ui="arcade"] 控制显隐 ——
  // 这样在切换器里换皮肤时，按钮会跟着即时出现/消失，不用刷新。
  var navUiGame = navUiSkins.some(function (s) { return s.id === 'arcade' })

  // 小游戏板块：内容清单在 source/_data/games.json，站主在后台「游戏」页维护。
  // 这里**故意不走 _config.fluid.yml 的 menu** —— 那一串是静态的，而小游戏要跟着
  // games.json 的开关走：整站关掉游戏时，导航项和游戏中心页一起消失，
  // 不会在栏上留一个点进去空空如也的死链接。
  var navGames = site.data.games || {}
  var navGameList = (navGames.games || []).filter(function (g) {
    return g && g.id && g.enabled !== false
  })
  var navGamesOn = navGames.enabled !== false && navGameList.length > 0
  var navFeatured = null
  for (var gi = 0; gi < navGameList.length; gi++) {
    if (navGameList[gi].id === navGames.featured) { navFeatured = navGameList[gi]; break }
  }
  if (!navFeatured) navFeatured = navGameList[0] || null
  // iconfont 里没有游戏类图标，直接内联一个摇杆
  var navGameIcon = '<svg class="nav-svg-ico" viewBox="0 0 16 16" width="16" height="16" ' +
    'fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" ' +
    'stroke-linejoin="round" aria-hidden="true">' +
    '<circle cx="8" cy="3.4" r="2"/><path d="M8 5.4v5.1"/>' +
    '<path d="M3.4 13.4h9.2"/><path d="M4.7 13.4l1.5-2.9"/><path d="M11.3 13.4l-1.5-2.9"/></svg>'
%>
<nav id="navbar" class="navbar fixed-top  navbar-expand-lg navbar-dark scrolling-navbar">
  <div class="container">
    <a class="navbar-brand" href="<%= url_for() %>">
      <strong><%= theme.navbar.blog_title || config.title %></strong>
    </a>

    <button id="navbar-toggler-btn" class="navbar-toggler" type="button" data-toggle="collapse"
            data-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <div class="animated-icon"><span></span><span></span><span></span></div>
    </button>

    <!-- Collapsible content (desktop) -->
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav ml-auto text-center">
        <% for(const each of theme.navbar.menu || []) { %>
          <% if (!each.submenu && !each.link) continue %>
          <% var text = each.name || __(each.key + '.menu') || __(each.key + '.title') %>
          <% if (text.indexOf('.menu') !== -1 || text.indexOf('.title') !== -1) {
            text = each.key
          } %>
          <% if (each.submenu) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" target="_self" href="javascript:;" role="button"
                 data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <%- each.icon ? '<i class="' + each.icon + '"></i>' : '' %>
                <span><%- text %></span>
              </a>
              <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                <% for(const subEach of each.submenu || []) { %>
                  <% if (!subEach.link) continue %>
                  <% var subText = subEach.name || __(subEach.key + '.title') %>
                  <% if (subText.indexOf('.title') !== -1) {
                    subText = subEach.key
                  } %>
                  <a class="dropdown-item" href="<%= url_for(subEach.link) %>" target="<%= subEach.target || '_self' %>">
                    <%- subEach.icon ? '<i class="' + subEach.icon + '"></i>' : '' %>
                    <span><%- subText %></span>
                  </a>
                <% } %>
              </div>
            </li>
          <% } else { %>
            <li class="nav-item">
              <a class="nav-link" href="<%= url_for(each.link) %>" target="<%= each.target || '_self' %>">
                <%- each.icon ? '<i class="' + each.icon + '"></i>' : '' %>
                <span><%- text %></span>
              </a>
            </li>
          <% } %>
        <% } %>
        <% if(navGamesOn) { %>
          <li class="nav-item" id="nav-games-btn">
            <a class="nav-link" href="<%= url_for('/games/') %>" target="_self"
               aria-label="小游戏" title="小游戏">
              <%- navGameIcon %><span>小游戏</span>
            </a>
          </li>
        <% } %>
        <% if(theme.search.enable) { %>
          <li class="nav-item" id="search-btn">
            <a class="nav-link" target="_self" href="javascript:;" data-toggle="modal" data-target="#modalSearch" aria-label="Search">
              <i class="iconfont icon-search"></i>
            </a>
          </li>
          <% import_js(theme.static_prefix.internal_js, 'local-search.js') %>
        <% } %>
        <% if(theme.dark_mode && theme.dark_mode.enable) { %>
          <li class="nav-item" id="color-toggle-btn">
            <a class="nav-link" target="_self" href="javascript:;" aria-label="Color Toggle">
              <i class="iconfont icon-dark" id="color-toggle-icon"></i>
            </a>
          </li>
        <% } %>
        <% if(navUiSwitchable) { %>
          <li class="nav-item" id="ui-toggle-btn">
            <a class="nav-link" target="_self" href="javascript:;" role="button"
               aria-label="界面风格" title="界面风格">
              <i class="iconfont icon-brush"></i>
            </a>
          </li>
        <% } %>
        <% if(navUiGame && navGamesOn) { %>
          <li class="nav-item nav-game-only" id="arcade-game-btn">
            <a class="nav-link" target="_self" href="javascript:;" role="button"
               aria-label="直接开一局" title="直接开一局：<%= navFeatured ? navFeatured.name : '小游戏' %>">
              <%- navGameIcon %>
            </a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<!-- Mobile grid menu overlay -->
<div id="mobile-grid-menu" class="d-lg-none">
  <div class="mobile-grid-menu-inner">
    <div class="container">
      <div class="row">
        <% for(const each of theme.navbar.menu || []) { %>
          <% if (!each.submenu && !each.link) continue %>
          <% var gridText = each.name || __(each.key + '.menu') || __(each.key + '.title') %>
          <% if (gridText.indexOf('.menu') !== -1 || gridText.indexOf('.title') !== -1) {
            gridText = each.key
          } %>
          <% if (each.submenu) { %>
            <%
              // Flatten submenu items as grid cells grouped under a header
              // First render the parent as a header row, then sub items
            %>
            <div class="col-12 mobile-grid-group-header">
              <%- each.icon ? '<i class="' + each.icon + '"></i>' : '' %>
              <span><%- gridText %></span>
            </div>
            <% for(const subEach of each.submenu || []) { %>
              <% if (!subEach.link) continue %>
              <% var subGridText = subEach.name || __(subEach.key + '.title') %>
              <% if (subGridText.indexOf('.title') !== -1) {
                subGridText = subEach.key
              } %>
              <div class="col-4 mobile-grid-cell">
                <a href="<%= url_for(subEach.link) %>" target="<%= subEach.target || '_self' %>">
                  <div class="mobile-grid-item">
                    <%- subEach.icon ? '<i class="' + subEach.icon + '"></i>' : '<i class="iconfont icon-link-fill"></i>' %>
                    <span><%- subGridText %></span>
                  </div>
                </a>
              </div>
            <% } %>
          <% } else { %>
            <div class="col-4 mobile-grid-cell">
              <a href="<%= url_for(each.link) %>" target="<%= each.target || '_self' %>">
                <div class="mobile-grid-item">
                  <%- each.icon ? '<i class="' + each.icon + '"></i>' : '<i class="iconfont icon-link-fill"></i>' %>
                  <span><%- gridText %></span>
                </div>
              </a>
            </div>
          <% } %>
        <% } %>
        <% if(navGamesOn) { %>
          <div class="col-4 mobile-grid-cell" id="mobile-games-btn">
            <a href="<%= url_for('/games/') %>" aria-label="小游戏">
              <div class="mobile-grid-item">
                <%- navGameIcon %>
                <span>小游戏</span>
              </div>
            </a>
          </div>
        <% } %>
        <% if(theme.search.enable) { %>
          <div class="col-4 mobile-grid-cell" id="mobile-search-btn">
            <a href="javascript:;" data-toggle="modal" data-target="#modalSearch" aria-label="Search">
              <div class="mobile-grid-item">
                <i class="iconfont icon-search"></i>
                <span><%= __('search.title') !== 'search.title' ? __('search.title') : 'Search' %></span>
              </div>
            </a>
          </div>
        <% } %>
        <% if(theme.dark_mode && theme.dark_mode.enable) { %>
          <div class="col-4 mobile-grid-cell" id="mobile-color-toggle-btn"
               data-label-light="<%= __('darkmode.light') %>"
               data-label-dark="<%= __('darkmode.dark') %>">
            <a href="javascript:;" aria-label="Color Toggle">
              <div class="mobile-grid-item">
                <i class="iconfont icon-dark" id="mobile-color-toggle-icon"></i>
                <span id="mobile-color-toggle-label"><%= __('darkmode.dark') %></span>
              </div>
            </a>
          </div>
        <% } %>
        <% if(navUiSwitchable) { %>
          <div class="col-4 mobile-grid-cell" id="mobile-ui-toggle-btn">
            <a href="javascript:;" aria-label="界面风格">
              <div class="mobile-grid-item">
                <i class="iconfont icon-brush"></i>
                <span>界面风格</span>
              </div>
            </a>
          </div>
        <% } %>
        <% if(navUiGame && navGamesOn) { %>
          <div class="col-4 mobile-grid-cell nav-game-only" id="mobile-arcade-game-btn">
            <a href="javascript:;" aria-label="直接开一局">
              <div class="mobile-grid-item">
                <%- navGameIcon %>
                <span>开一局</span>
              </div>
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
