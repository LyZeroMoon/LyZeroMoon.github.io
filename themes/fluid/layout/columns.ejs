<%
page.layout = 'columns'
page.title = page.title || '专栏'
page.subtitle = page.subtitle || '按主题整理的系列文章'
page.banner_img = page.banner_img || theme.page.banner_img
page.banner_img_height = page.banner_img_height || theme.page.banner_img_height
page.banner_mask_alpha = page.banner_mask_alpha || theme.page.banner_mask_alpha

var columnMeta = (site.data && site.data.columns) || []
var metaMap = {}
columnMeta.forEach(function (c) { if (c && c.name) metaMap[c.name] = c })

var palette = ['#378ADD', '#639922', '#7F77DD', '#D85A30', '#D4537E', '#1D9E75', '#BA7517', '#185FA5']
var cats = site.categories.filter(function (c) { return c.length > 0 }).sort('name').toArray()
%>

<style>
  .columns-intro {
    margin: 0 0 22px;
    color: var(--sec-text-color);
    font-size: 14px;
    line-height: 1.7;
  }
  .columns-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 18px;
    margin-bottom: 32px;
  }
  .column-card {
    display: flex;
    flex-direction: column;
    /* 颜色一律走主题变量：这样 10 套皮肤、暗色模式都自动跟上，
       不用逐个写 [data-...] 覆盖块（原来那组 data-color-scheme 选择器
       属性名就是错的，一直没生效） */
    background: color-mix(in srgb, var(--text-color) 3%, var(--board-bg-color));
    border: 1px solid var(--line-color);
    border-radius: 12px;
    padding: 20px 20px 16px;
    text-decoration: none !important;
    color: inherit;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    overflow: hidden;
  }
  .column-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 26px rgba(16, 24, 40, .1);
    border-color: color-mix(in srgb, var(--text-color) 18%, var(--line-color));
  }
  .column-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .column-badge {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 19px;
  }
  .column-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-color);
    line-height: 1.3;
  }
  .column-count {
    font-size: 12px;
    color: var(--sec-text-color);
    margin-top: 2px;
  }
  .column-desc {
    font-size: 13px;
    color: var(--sec-text-color);
    line-height: 1.65;
    margin: 0 0 14px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .column-posts {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    border-top: 1px dashed var(--line-color);
    padding-top: 12px;
    flex-grow: 1;
  }
  .column-posts li {
    display: flex;
    align-items: baseline;
    gap: 9px;
    margin: 0 0 7px;
    font-size: 13px;
    line-height: 1.5;
  }
  .column-posts li:last-child { margin-bottom: 0; }
  .column-posts .d {
    flex-shrink: 0;
    font-size: 11.5px;
    color: var(--post-link-color);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .column-posts .t {
    color: var(--text-color);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .column-card:hover .column-posts .t { color: var(--post-link-color); }
  .column-foot {
    font-size: 12.5px;
    padding-top: 2px;
    opacity: .78;
  }
  .columns-empty {
    text-align: center;
    color: var(--sec-text-color);
    padding: 60px 20px;
    font-size: 14px;
  }

  /* 暗色/皮肤适配不用在这里写：上面全部走的是主题变量（--text-color 等），
     主题和 source/css/skins.css 已经在切皮肤时改过这些变量了。
     原先那组 [data-color-scheme="dark"] 选择器属性名就是错的（主题注入的是
     data-user-color-scheme），一直没生效，已移除。 */

  @media (max-width: 576px) {
    .columns-grid { grid-template-columns: 1fr; gap: 14px; }
    .column-card { padding: 17px 17px 14px; }
  }
</style>

<p class="columns-intro">
  按主题整理的系列文章。点开任意一个专栏，可以看到该主题下的全部文章。
</p>

<% if (cats.length === 0) { %>
  <div class="columns-empty">还没有任何专栏，去写第一篇文章吧。</div>
<% } else { %>
<div class="columns-grid">
  <% cats.forEach(function (cat, idx) { %>
    <%
    var meta = metaMap[cat.name] || {}
    var color = meta.color || palette[idx % palette.length]
    var icon = meta.icon || 'iconfont icon-books'
    var desc = meta.description || ('围绕「' + cat.name + '」的系列文章，持续更新中。')
    /* 预览也按阅读顺序取前 4 篇，和点进去看到的列表保持一致 ——
       否则卡片上是「最近更新」、内页是「从第一节开始」，读起来是矛盾的。
       序号未知（标题里没有编号）的退回显示日期。 */
    var rows = colSortedPosts(cat.posts.toArray())
    var recent = rows.slice(0, 4)
    %>
    <a class="column-card" href="<%= url_for(cat.path) %>">
      <div class="column-top">
        <span class="column-badge" style="background: <%= color %>1f; color: <%= color %>;">
          <i class="<%= icon %>"></i>
        </span>
        <div>
          <div class="column-name"><%= cat.name %></div>
          <div class="column-count"><%= cat.length %> 篇文章</div>
        </div>
      </div>

      <p class="column-desc"><%= desc %></p>

      <ul class="column-posts">
        <% recent.forEach(function (row) { %>
          <li>
            <span class="d"><%= row.ord === null ? date(row.post.date, 'MM-DD') : colOrdLabel(row.ord) %></span>
            <span class="t"><%= row.post.title %></span>
          </li>
        <% }) %>
      </ul>

      <div class="column-foot" style="color: <%= color %>;">
        <% if (cat.length > recent.length) { %>还有 <%= cat.length - recent.length %> 篇 · <% } %>查看全部 →
      </div>
    </a>
  <% }) %>
</div>
<% } %>

<%- inject_point('pageComments') %>
